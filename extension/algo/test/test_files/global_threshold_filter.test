-DATASET CSV empty
--

-CASE GlobalThresholdAbove
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE N(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N, weight DOUBLE)
---- ok
-STATEMENT CREATE (:N {id:0}),(:N {id:1}),(:N {id:2})
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:1}) CREATE (x)-[:E {weight:1}]->(y)
---- ok
-STATEMENT MATCH (x:N {id:1}),(y:N {id:2}) CREATE (x)-[:E {weight:3}]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G', ['N'], ['E'])
---- ok
-STATEMENT CALL global_threshold_filter('G', threshold := 2, above := true) RETURN source, target, weight ORDER BY source, target
---- 1
1|2|3.000000

-CASE GlobalThresholdBelow
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE N(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N, weight DOUBLE)
---- ok
-STATEMENT CREATE (:N {id:0}),(:N {id:1}),(:N {id:2})
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:1}) CREATE (x)-[:E {weight:1}]->(y)
---- ok
-STATEMENT MATCH (x:N {id:1}),(y:N {id:2}) CREATE (x)-[:E {weight:3}]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G', ['N'], ['E'])
---- ok
-STATEMENT CALL global_threshold_filter('G', threshold := 2, above := false) RETURN source, target, weight ORDER BY source, target
---- 1
0|1|1.000000
