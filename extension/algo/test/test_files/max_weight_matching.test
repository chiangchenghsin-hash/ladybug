-DATASET CSV empty
--

-CASE MatchingWeightedChain
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE N(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N, weight DOUBLE)
---- ok
-STATEMENT CREATE (:N {id:0}),(:N {id:1}),(:N {id:2})
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:1}) CREATE (x)-[:E {weight:3}]->(y)
---- ok
-STATEMENT MATCH (x:N {id:1}),(y:N {id:2}) CREATE (x)-[:E {weight:2}]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G', ['N'], ['E'])
---- ok
-STATEMENT CALL max_weight_matching('G') RETURN source, target, weight, is_matched ORDER BY source, target
---- 2
0|1|3.000000|True
1|2|2.000000|False
