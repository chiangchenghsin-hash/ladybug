-DATASET CSV empty
--

-CASE TriangleCountK4
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE N(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id:0}),(:N {id:1}),(:N {id:2}),(:N {id:3})
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:1}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:2}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:3}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:1}),(y:N {id:2}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:1}),(y:N {id:3}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:2}),(y:N {id:3}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G', ['N'], ['E'])
---- ok
-STATEMENT CALL triangle_count('G') RETURN count
---- 1
4
-STATEMENT CALL global_clustering('G') RETURN clustering_coefficient
---- 1
1.000000

-CASE TriangleCountTriTail
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE T(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE R(FROM T TO T)
---- ok
-STATEMENT CREATE (:T {id:0}),(:T {id:1}),(:T {id:2}),(:T {id:3})
---- ok
-STATEMENT MATCH (x:T {id:0}),(y:T {id:1}) CREATE (x)-[:R]->(y)
---- ok
-STATEMENT MATCH (x:T {id:1}),(y:T {id:2}) CREATE (x)-[:R]->(y)
---- ok
-STATEMENT MATCH (x:T {id:2}),(y:T {id:0}) CREATE (x)-[:R]->(y)
---- ok
-STATEMENT MATCH (x:T {id:0}),(y:T {id:3}) CREATE (x)-[:R]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G2', ['T'], ['R'])
---- ok
-STATEMENT CALL triangle_count('G2') RETURN count
---- 1
1
-STATEMENT CALL global_clustering('G2') RETURN clustering_coefficient
---- 1
0.600000
