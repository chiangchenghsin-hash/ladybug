-DATASET CSV empty
--

-CASE EigenvectorStar
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE N(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id:0}),(:N {id:1}),(:N {id:2}),(:N {id:3}),(:N {id:4}),(:N {id:5})
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:1}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:2}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:3}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:4}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:5}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G', ['N'], ['E'])
---- ok
-STATEMENT CALL eigenvector_centrality('G') RETURN node.id, score ORDER BY node.id
---- 6
0|1.000000
1|0.447214
2|0.447214
3|0.447214
4|0.447214
5|0.447214

-CASE EigenvectorPath
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE T(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE R(FROM T TO T)
---- ok
-STATEMENT CREATE (:T {id:0}),(:T {id:1}),(:T {id:2})
---- ok
-STATEMENT MATCH (x:T {id:0}),(y:T {id:1}) CREATE (x)-[:R]->(y)
---- ok
-STATEMENT MATCH (x:T {id:1}),(y:T {id:2}) CREATE (x)-[:R]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G2', ['T'], ['R'])
---- ok
-STATEMENT CALL eigenvector_centrality('G2') RETURN node.id, score ORDER BY node.id
---- 3
0|0.707107
1|1.000000
2|0.707107
