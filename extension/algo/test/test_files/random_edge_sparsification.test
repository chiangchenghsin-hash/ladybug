-DATASET CSV empty
--

-CASE RandomEdgeRatioOne
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE N(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id:0}),(:N {id:1}),(:N {id:2})
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:1}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:2}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:1}),(y:N {id:2}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G', ['N'], ['E'])
---- ok
-STATEMENT CALL random_edge_sparsification('G', ratio := 1.0) RETURN source, target, is_kept ORDER BY source, target
---- 3
0|1|True
0|2|True
1|2|True

-CASE RandomEdgeRatioZero
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CREATE NODE TABLE N(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id:0}),(:N {id:1}),(:N {id:2})
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:1}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:0}),(y:N {id:2}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT MATCH (x:N {id:1}),(y:N {id:2}) CREATE (x)-[:E]->(y)
---- ok
-STATEMENT CALL PROJECT_GRAPH('G', ['N'], ['E'])
---- ok
-STATEMENT CALL random_edge_sparsification('G', ratio := 0.0) RETURN source, target, is_kept ORDER BY source, target
---- 3
0|1|False
0|2|False
1|2|False
